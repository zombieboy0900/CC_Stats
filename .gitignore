# Patient-level data never enters this repository. data/raw/ holds the clinical
# workbooks (with surgery dates); data/derived/ is rebuilt from them by
# `pixi run build-analysis`. See "Getting the data" in the README.
data/raw/
data/derived/
# Questions for the data owner: they name study IDs.
data/questions/

# Results are regenerated by running the analysis, and are not published here
# ahead of the paper. Notebook outputs are stripped on commit by nbstripout
# (`pixi run setup-git`); these are the files the scripts and notebooks write.
analysis/**/*.csv
analysis/**/*.png
results/

# Kept locally, outside this repository: superseded work and the poster,
# abstract and reference papers.
archive/
deliverables/

# pixi environments
.pixi/*
!.pixi/config.toml

# Python and Jupyter
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# R
.Rhistory
.RData

# Editor and OS
.claude/
.vscode/
.DS_Store
._*
